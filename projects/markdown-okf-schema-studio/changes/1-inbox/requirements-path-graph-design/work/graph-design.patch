+function pill(left: number, cy: number, label: string, stroke: string, dashed = false): { svg: string; width: number } {
+  const width = label.length * 6.8 + 20;
+  return {
+    width,
+    svg: `<rect class="pill" x="${left.toFixed(0)}" y="${cy - 11}" width="${width.toFixed(0)}" height="22" rx="11" stroke="${stroke}"${dashed ? ' stroke-dasharray="4 3"' : ""}/><text class="pt" x="${(left + width / 2).toFixed(0)}" y="${cy + 4}" text-anchor="middle">${escapeHtml(label)}</text>`,
+  };
+}
