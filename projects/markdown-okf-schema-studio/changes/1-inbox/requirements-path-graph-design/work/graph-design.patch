+/** One lane per path; a state met again keeps the column of its first lane when it can. */
+export function buildLanes(paths: readonly MainPath[]): Lane[] {
+  const first = new Map<string, { col: number; lane: number }>();
+  const seenVia = new Set<string>();
+  return paths.map((path, laneIndex) => {
+    const states: LaneState[] = [];
+    const vias: (PathTransition | undefined)[] = [];
+    path.steps.forEach((step, index) => {
+      const known = first.get(step.state);
+      const after = index === 0 ? 0 : (states[index - 1]?.col ?? 0) + 1;
+      const col = known !== undefined && known.col >= after ? known.col : after;
+      states.push({ key: step.state, col, goal: index === path.steps.length - 1, ...(known ? { from: known.lane } : {}), options: step.options });
+      vias.push(step.via);
+    });
+    const viaKey = (index: number): string => `${states[index]?.key ?? ""}>${states[index + 1]?.key ?? ""}>${vias[index]?.id ?? ""}`;
+    const sharedVia = states.map((_, index) => Boolean(vias[index] && states[index + 1] && seenVia.has(viaKey(index))));
+    states.forEach((state, index) => {
+      if (!first.has(state.key)) first.set(state.key, { col: state.col, lane: laneIndex });
+      if (states[index + 1]) seenVia.add(viaKey(index));
+    });
+    return { states, vias, sharedVia };
+  });
+}
