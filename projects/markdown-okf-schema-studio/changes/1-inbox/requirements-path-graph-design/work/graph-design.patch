+interface LaneState {
+  readonly key: string;
+  readonly col: number;
+  readonly goal: boolean;
+  /** The index of the earlier path that already holds this state, if any. */
+  readonly from?: number;
+  readonly options: readonly PathTransition[];
+}
+
+interface Lane {
+  readonly states: LaneState[];
+  readonly vias: (PathTransition | undefined)[];
+  /** The way to the next state is also a way of an earlier path. */
+  readonly sharedVia: boolean[];
+}
+
+const COLUMN = 230, PAD_LEFT = 100, NAME_WRAP = 24, CAPTION_WRAP = 33, LINE = 17, CHAR = 6.4, INLINE_ROOM = 420;
+const MAX_PATH_COLOURS = 3;
