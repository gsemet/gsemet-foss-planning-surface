{
  "name": "UX-13-tab-between-cells",
  "file": "fixtures-visual/04-code-and-tables.md",
  "vars": {"st": "(D.querySelector('[data-sphinx-table-menu] [data-sphinx-preview-edit-status]')||{}).textContent", "ta": "[data-sphinx-preview-table-cell-editor] textarea"},
  "steps": [
    {"open": "${file}"},
    {"waitFor": "/Code, tables/.test((D.querySelector('#sphinx-myst-preview-content h1')||{}).textContent||'')", "timeout": 15000, "label": "preview follows file"},
    {"mark": "${file}"},
    {"editMode": true},
    {"clicksel": "td", "text": "East", "exact": true, "nth": 0},
    {"waitFor": "D.querySelector('${ta}')", "label": "cell editor"},
    {"eval": "${st}"},
    {"key": "End"},
    {"type": "X"},
    {"key": "Tab", "wait": 700},
    {"check": "feval", "expr": "${st}", "equals": "Row 3 of 6 · column 3 of 16", "label": "UX-13 Tab moves to next cell"},
    {"check": "focus", "selector": "textarea", "label": "UX-13 focus stays in cell editor after Tab"},
    {"eval": "D.querySelector('${ta}').value"},
    {"key": "Shift+Tab", "wait": 700},
    {"check": "feval", "expr": "${st}", "equals": "Row 3 of 6 · column 2 of 16", "label": "UX-13 Shift+Tab moves back"},
    {"eval": "D.querySelector('${ta}').value"},
    {"key": "Escape", "wait": 1200},
    {"check": "feval", "expr": "!D.querySelector('[data-sphinx-preview-table-cell-editor]')", "label": "UX-13 Escape closes cell editor"},
    {"check": "diff", "file": "${file}", "against": "mark", "maxLines": 1, "contains": "| nw-03 | EastX | 6 |", "show": true, "label": "UX-13 typed value committed, one line"},
    {"mark": "${file}"},
    {"clicksel": "td", "text": "complete", "exact": true, "nth": 4},
    {"waitFor": "D.querySelector('${ta}')", "label": "cell editor last cell"},
    {"eval": "${st}"},
    {"key": "Tab", "wait": 900},
    {"check": "feval", "expr": "${st}", "equals": "Row 7 of 7 · column 1 of 16", "label": "UX-13 Tab on last cell adds a row"},
    {"check": "focus", "selector": "textarea", "label": "UX-13 focus in new row"},
    {"type": "nw-99"},
    {"key": "Enter", "wait": 1200},
    {"check": "feval", "expr": "!D.querySelector('[data-sphinx-preview-table-cell-editor]')", "label": "cell editor closed after Enter"},
    {"check": "diff", "file": "${file}", "against": "mark", "maxLines": 1, "contains": "nw-99", "show": true, "label": "UX-13 new row only"},
    {"check": "errors"},
    {"shot": "UX-13-fail", "clip": "preview", "onFail": true}
  ]
}
