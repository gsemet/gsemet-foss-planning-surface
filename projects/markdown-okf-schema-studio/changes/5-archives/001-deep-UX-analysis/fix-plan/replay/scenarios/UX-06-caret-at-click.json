      "dx": 40,
      "dy": 8
    },
    {
      "waitFor": "D.querySelector('[data-sphinx-preview-block-editor] textarea')",
      "label": "block editor open"
    },
    {
      "eval": "(()=>{const t=D.querySelector('[data-sphinx-preview-block-editor] textarea'); if(!t) return 'NO TEXTAREA'; const c=t.selectionStart; return JSON.stringify({caret:c,len:t.value.length,line:t.value.slice(0,c).split('\\n').length,ctx:t.value.slice(Math.max(0,c-14),c)+'|'+t.value.slice(c,c+14)})})()"
    },
    {
      "type": "Z"
    },
    {
      "wait": 800
    },
