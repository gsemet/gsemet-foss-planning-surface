{
  "name": "UX-28-setup",
  "file": "book/chapters/02-foundations.md",
  "steps": [
    {"open": "${file}", "wait": 1500},
    {"palette": "Markdown OKF-Schema Studio: Open Preview to Side", "wait": 5000},
    {"waitFor": "(D.querySelector('#sphinx-myst-preview-content h1')||{}).textContent.includes('Foundations')", "timeout": 30000, "label": "preview shows 02-foundations"},
    {"editMode": false, "wait": 3000},
    {"key": "Meta+1", "wait": 500},
    {"key": "Control+g", "wait": 700},
    {"type": "44", "wait": 400},
    {"key": "Enter", "wait": 500},
    {"key": "End", "wait": 4000},
    {"check": "editor", "active": "${file}"}
  ]
}
