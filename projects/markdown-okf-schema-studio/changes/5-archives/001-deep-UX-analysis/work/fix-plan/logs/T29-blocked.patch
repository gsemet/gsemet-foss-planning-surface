+      return block === undefined
+        ? undefined
+        : { text: block.textContent, top: block.getBoundingClientRect().top, scrollY: window.scrollY };
+    });
+    const visible = await probe();
+    assert.ok(visible, "a block is visible");
+    // Put the caret in a visible paragraph so that source-to-preview sync leaves the page alone.
+    const paragraph = Number(/Paragraph (\d+)/.exec(visible.text ?? "")?.[1]);
+    assert.ok(Number.isFinite(paragraph), "the visible block is a numbered paragraph");
+    const caretLine = source.lineAt(2 + paragraph * 2);
+    await vscode.window.showTextDocument(source, vscode.ViewColumn.One);
+    editor.selection = new vscode.Selection(caretLine.range.end, caretLine.range.end);
