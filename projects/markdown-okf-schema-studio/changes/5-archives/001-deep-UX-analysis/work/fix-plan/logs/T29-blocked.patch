+/**
+ * RI-T29: while a render is pending, the status region changes in place; the webview document is
+ * not replaced just to say "Preview pending".
+ */
+async function scenarioPendingWithoutReload(page: Page): Promise<void> {
+  await withDocument("realinput-t29", "# Pending status\n\nBody text.\n", async (source) => {
+    await openSidePreview(source);
+    await waitForRender(source);
+    // Let the ready report arrive and any follow-up assignment settle before counting.
+    await waitFor("the ready webview", async () => (await findCurrentFrame(page)) !== undefined);
+    const editor = await vscode.window.showTextDocument(source, vscode.ViewColumn.One);
+    const end = source.positionAt(source.getText().length);
+    editor.selection = new vscode.Selection(end, end);
+    await waitForRenderChurnToSettle();
+    const before = htmlAssignmentCount();
+    const frame = await withCurrentFrame(page, async (current) => current);
+    try {
+      setRenderDelayForTests(500);
+      await page.keyboard.type("x");
+      try {
+        await waitFor("the same frame to report pending", async () => {
+          const status = await frame.locator("[data-sphinx-preview-status]").getAttribute("data-sphinx-preview-status");
+          return status === "pending";
+        });
+      } catch (error) {
+        const preview = getActivePreviewForTests();
+        throw new Error(String(error) + " buffer=" + JSON.stringify(bufferText(source))
+          + " phase=" + preview?.phase + " status=" + preview?.status
+          + " assignments=" + preview?.htmlAssignments + " before=" + before);
+      }
+      const atPending = htmlAssignmentCount();
+      assert.equal(atPending, before, "pending must not assign the webview html");
+      assert.equal(
+        await frame.locator("[data-sphinx-preview-status] strong").textContent(),
+        "Preview pending",
+      );
+    } finally {
+      resetRenderHooksForTests();
+    }
+    await waitForRender(source);
+    await waitFor("the settled render", () => getActivePreviewForTests()?.status === "success");
+    const delta = htmlAssignmentCount() - before;
+    assert.ok(delta <= 2, "html assignments for one edit: " + delta);
+    console.log("RI-T29 html assignments for one edit: " + delta);
+  });
+}
+
+/** Opening a preview triggers follow-up renders; waits until the assignment counter stays put. */
+async function waitForRenderChurnToSettle(): Promise<void> {
+  let lastSeen = "";
+  let stableSince = Date.now();
+  let lastCount = htmlAssignmentCount();
+  try {
+    await waitFor("the render churn after opening to settle", () => {
+      const preview = getActivePreviewForTests();
+      lastSeen = JSON.stringify({
+        count: htmlAssignmentCount(),
+        phase: preview?.phase,
+        ready: preview?.webviewReady,
+        status: preview?.status,
+      });
+      const count = htmlAssignmentCount();
+      if (count !== lastCount) {
+        lastCount = count;
+        stableSince = Date.now();
+      }
+      return Date.now() - stableSince >= 2_500 && preview?.phase === "ready"
+        && preview.webviewReady === true;
+    }, 40_000);
+  } catch (error) {
+    throw new Error(String(error) + " last=" + lastSeen);
+  }
+}
+
+/**
+ * RI-T29b: the in-place pending banner must not move the reading position. The first block that is
+ * fully inside the viewport keeps its viewport top when a render starts.
+ */
+async function scenarioPendingKeepsReadingPosition(page: Page): Promise<void> {
+  const body = Array.from({ length: 80 }, (_, index) => "Paragraph " + index + " keeps the reader busy.")
+    .join("\n\n");
+  await withDocument("realinput-t29b", "# Reading position\n\n" + body + "\n", async (source) => {
+    await openSidePreview(source);
+    await waitForRender(source);
+    await waitFor("the ready webview", async () => (await findCurrentFrame(page)) !== undefined);
+    const editor = await vscode.window.showTextDocument(source, vscode.ViewColumn.One);
+    await waitForRenderChurnToSettle();
+    const frame = await withCurrentFrame(page, async (current) => current);
+    // Editor-to-preview sync would scroll the page on its own when the source changes; switch it
+    // off so that only the banner can move the content.
+    const anchorButton = frame.locator("[data-sphinx-preview-anchor]");
+    if (await anchorButton.getAttribute("aria-pressed") === "true") {
+      await anchorButton.click();
+      await waitFor("anchoring to be off", async () =>
+        await anchorButton.getAttribute("aria-pressed") === "false");
+    }
+    const element = await frame.frameElement();
+    const bounds = await element.boundingBox();
+    assert.ok(bounds, "the preview pane is visible");
+    await page.mouse.move(bounds.x + bounds.width / 2, bounds.y + Math.min(200, bounds.height / 2));
+    await page.mouse.wheel(0, 600);
+    await waitFor("the preview to scroll", async () => await frame.evaluate(() => window.scrollY) > 300);
+    await new Promise<void>((resolve) => setTimeout(resolve, 600));
+    const probe = () => frame.evaluate(() => {
+      const blocks = Array.from(document.querySelectorAll("#sphinx-myst-preview-content p"));
