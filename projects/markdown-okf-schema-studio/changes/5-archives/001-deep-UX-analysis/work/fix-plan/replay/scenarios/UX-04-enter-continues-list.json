{
  "name": "UX-04-enter-continues-list",
  "file": "fixtures-visual/04-code-and-tables.md",
  "vars": {"typed": "Frozen goods"},
  "steps": [
    {"key": "Escape", "wait": 600, "optional": true},
    {"palette": "File: Revert File", "wait": 1200},
    {"palette": "View: Close All Editors", "wait": 1500},
    {"open": "${file}"},
    {"palette": "Markdown OKF-Schema Studio: Open Preview to Side", "wait": 5000},
    {"waitFor": "D.querySelector('#sphinx-myst-preview-content h1')", "timeout": 20000, "label": "rendered preview"},
    {"mark": true},
    {"editMode": true},
    {"clicksel": "li", "text": "Dry goods", "exact": true},
    {"waitFor": "D.querySelector('[data-sphinx-preview-block-editor] textarea')", "label": "block editor open"},
    {"eval": "JSON.stringify(D.querySelector('[data-sphinx-preview-block-editor] textarea').value)"},
    {"key": "Meta+ArrowDown"},
    {"key": "Enter", "wait": 300},
    {"eval": "(() => { const t = D.querySelector('[data-sphinx-preview-block-editor] textarea'); return JSON.stringify({value: t.value, caret: t.selectionStart}); })()"},
    {"type": "${typed}", "delay": 40},
    {"eval": "JSON.stringify(D.querySelector('[data-sphinx-preview-block-editor] textarea').value)"},
    {"key": "Meta+Enter", "wait": 1500},
    {"check": "diff", "against": "mark", "maxLines": 1, "contains": "      - Frozen goods", "show": true, "label": "UX-04 sibling item inserted with sibling indentation"},
    {"check": "feval", "expr": "(() => { const li = [...D.querySelectorAll('li')].find(l => l.firstChild && l.textContent.trim().startsWith('Deduplication')); return !!li && li.parentElement.closest('li').textContent.trim().startsWith('Intake'); })()", "label": "UX-04 Deduplication still a child of Intake"},
    {"check": "errors"},
    {"shot": "UX-04-after-commit", "clip": "preview"}
  ]
}
