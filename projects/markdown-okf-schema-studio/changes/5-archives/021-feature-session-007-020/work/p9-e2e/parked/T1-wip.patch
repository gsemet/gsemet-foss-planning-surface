+    The manifest of a real-input run lists its captures (`captureList`) with the README crops of the
+    registry (`test/shared/captureRegistry.ts`); the PNG is `<run folder>/<group>/rNN-<slug>.png`.
+    """
+    manifest_path = directory / "manifest.json"
+    if not manifest_path.is_file():
+        raise RuntimeError(f"{manifest_path} is missing")
+    captures = json.loads(manifest_path.read_text(encoding="utf-8")).get("captureList")
+    if captures is None:
+        raise RuntimeError(f"{manifest_path} has no captureList: run the real-input suite with the current code")
+    crops = []
+    for capture in captures:
+        for readme in capture.get("readme", []):
+            if capture.get("file") is None:
+                raise RuntimeError(f"README source {capture['id']} wrote no picture")
+            crops.append(Crop(directory / capture["file"], readme["file"], tuple(readme["crop"]), readme["width"]))
+    return crops
+
