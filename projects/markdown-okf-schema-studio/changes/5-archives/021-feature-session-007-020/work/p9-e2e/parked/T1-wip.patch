+def pixel_difference(first: Path, second: Path) -> str:
+    """Describes how two images differ: size mismatch, or the largest channel difference and the share of pixels."""
+    with Image.open(first) as left, Image.open(second) as right:
+        a, b = left.convert("RGB"), right.convert("RGB")
+        if a.size != b.size:
+            return f"size {a.size} against {b.size}"
+        difference = ImageChops.difference(a, b)
+        highest = max(high for _, high in difference.getextrema())
+        changed = sum(1 for pixel in difference.getdata() if pixel != (0, 0, 0))
+        return f"largest channel difference {highest}, {changed} of {a.size[0] * a.size[1]} pixels differ"
+
